# Optional. Leave blank until the real value is known.
# Do not invent an email address or social profile.

# Production site URL, used for canonical links, Open Graph URLs, and the sitemap.
# Example: https://www.cloudninebakery.example
NEXT_PUBLIC_SITE_URL=

# Business email. Shown on the site only after you add a real address here.
NEXT_PUBLIC_BUSINESS_EMAIL=

# Social profiles. Shown only when a real http(s) URL is provided.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
